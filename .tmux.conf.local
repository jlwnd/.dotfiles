## Minimal oh-my-tmux local overrides
# Keeps the default prefix (C-b) and provides a small plugin list and sensible defaults.
# This file is intended to be linked to ~/.tmux.conf.local by the installer script.

# Enable mouse support
set -g mouse on

# TPM plugins
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'
set -g @plugin 'tmux-plugins/tmux-yank'
set -g @plugin 'tmux-plugins/tmux-prefix-highlight'
set -g @plugin 'christoomey/vim-tmux-navigator'

# Automatically restore sessions and save every 15 minutes
set -g @continuum-restore 'on'
set -g @continuum-save-interval '15'

# macOS clipboard integration (change if not on macOS)
set -g @yank_command "pbcopy"

# Smart pane switching: if the pane is running vim/nvim, send a <C-w><dir> to the
# editor so it handles split navigation. Otherwise let tmux change panes.
bind -n C-h if-shell 'ps -o state= -o comm= -t "#{pane_tty}" | grep -E "(vim|n?vim)" >/dev/null' "send-keys C-h" "select-pane -L"
bind -n C-j if-shell 'ps -o state= -o comm= -t "#{pane_tty}" | grep -E "(vim|n?vim)" >/dev/null' "send-keys C-j" "select-pane -D"
bind -n C-k if-shell 'ps -o state= -o comm= -t "#{pane_tty}" | grep -E "(vim|n?vim)" >/dev/null' "send-keys C-k" "select-pane -U"
bind -n C-l if-shell 'ps -o state= -o comm= -t "#{pane_tty}" | grep -E "(vim|n?vim)" >/dev/null' "send-keys C-l" "select-pane -R"

# Initialize TPM (tmux plugin manager)
run -b '~/.tmux/plugins/tpm/tpm'
