# Shared Git configuration (tracked in the dotfiles repo).
#
# Machine-specific settings (user.name, user.email, credential helpers, ...)
# belong in ~/.gitconfig.local, which is NOT tracked. It is created by
# scripts/setup_git.sh.
#
# NOTE: ~/.gitconfig is a symlink into this repo, so `git config --global ...`
# and `gh auth setup-git` would write here. Use
# `git config --file ~/.gitconfig.local ...` instead.

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true  # use n and N to move between diff sections
	light = false    # set to true if you're in a terminal w/ a light background color

[merge]
	conflictstyle = diff3

[diff]
	colorMoved = default

[pull]
	ff = only

[init]
	defaultBranch = main

[alias]
	co = checkout
	sw = switch
	br = branch
	ci = commit
	st = status
	last = log -1 HEAD
	unstage = restore --staged --

# Must stay LAST: later values override earlier ones, so local settings win.
[include]
	path = ~/.gitconfig.local
